---
import Base from '../layouts/Base.astro';
import { getCities } from '../lib/data.js';

const cities = getCities();
const title = 'Page Not Found';
const description = 'The page you are looking for could not be found. Browse our directory of Arizona spiritual retreats instead.';
---

<Base title={title} description={description}>
  <div class="sr-container sr-404">
    <h1>404 — Page Not Found</h1>
    <p class="sr-404__message">
      The page you're looking for doesn't exist or may have moved.
      Try one of these popular destinations instead:
    </p>

    <div class="sr-404__links">
      <a href="/" class="sr-404__link">Home</a>
      {cities.slice(0, 6).map(city => (
        <a href={`/in/${city.slug}/`} class="sr-404__link">{city.name}</a>
      ))}
      <a href="/about/" class="sr-404__link">About</a>
      <a href="/contact/" class="sr-404__link">Contact</a>
    </div>
  </div>

  <style>
    .sr-404 {
      text-align: center;
      padding: 4rem 0;
    }

    .sr-404 h1 {
      font-size: 2.5rem;
      color: var(--accent-primary);
      margin-bottom: 1rem;
    }

    .sr-404__message {
      font-size: 1.15rem;
      color: var(--text-secondary);
      max-width: 500px;
      margin: 0 auto 2.5rem;
    }

    .sr-404__links {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.75rem;
    }

    .sr-404__link {
      display: inline-block;
      padding: 0.6rem 1.25rem;
      background-color: var(--surface-secondary);
      border: 1px solid var(--border);
      border-radius: 0.375rem;
      color: var(--text-primary);
      font-weight: 500;
      transition: all 0.2s;
    }

    .sr-404__link:hover {
      border-color: var(--accent-primary);
      color: var(--accent-primary);
      transform: translateY(-1px);
    }
  </style>
</Base>
