---
import Base from '../layouts/Base.astro';
import { SITE_CONFIG } from '../config.mjs';
import { getCities } from '../lib/data.js';

const cities = getCities();
const title = 'Find Spiritual Retreats in Arizona';
const description = SITE_CONFIG.description;
---

<Base title={title} description={description}>
  <div class="sr-container">
    <section class="sr-hero">
      <h1>{title}</h1>
      <p class="sr-hero__subtitle">{SITE_CONFIG.tagline}</p>
    </section>

    <section class="sr-cities">
      <h2>Explore by City</h2>
      <div class="sr-grid">
        {cities.map(city => (
          <a href={`/in/${city.slug}/`} class="sr-city-card">
            <h3>{city.name}, {city.state}</h3>
            <p class="sr-city-card__count">{city.count} retreat{city.count !== 1 ? 's' : ''}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="sr-cta">
      <h2>Own a Retreat Center?</h2>
      <p>Get featured on our directory and reach seekers looking for your services.</p>
      <a href="/pricing/" class="sr-button">View Pricing</a>
    </section>
  </div>

  <style>
    .sr-hero {
      text-align: center;
      margin-bottom: 3rem;
    }

    .sr-hero h1 {
      color: var(--accent-primary);
      font-size: 2.75rem;
    }

    .sr-hero__subtitle {
      font-size: 1.25rem;
      color: var(--text-secondary);
      max-width: 600px;
      margin: 1rem auto;
    }

    .sr-cities h2 {
      margin-bottom: 1.5rem;
    }

    .sr-city-card {
      display: block;
      padding: 1.5rem;
      background-color: var(--surface-secondary);
      border: 1px solid var(--border);
      border-radius: 0.5rem;
      transition: all 0.2s;
      color: inherit;
    }

    .sr-city-card:hover {
      border-color: var(--accent-primary);
      box-shadow: 0 4px 12px rgba(45, 95, 79, 0.1);
      transform: translateY(-2px);
    }

    .sr-city-card h3 {
      margin-bottom: 0.5rem;
      color: var(--accent-primary);
    }

    .sr-city-card__count {
      font-size: 0.875rem;
      color: var(--text-secondary);
    }

    .sr-cta {
      margin-top: 4rem;
      padding: 2rem;
      background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
      color: var(--surface-primary);
      border-radius: 0.5rem;
      text-align: center;
    }

    .sr-cta h2 {
      color: inherit;
    }

    .sr-cta p {
      margin-bottom: 1rem;
      color: rgba(255, 255, 255, 0.9);
    }

    .sr-button {
      display: inline-block;
      padding: 0.875rem 2rem;
      background-color: var(--accent-warm);
      color: white;
      border-radius: 0.25rem;
      font-weight: 600;
      transition: background-color 0.2s;
    }

    .sr-button:hover {
      background-color: #b86a35;
    }
  </style>
</Base>
