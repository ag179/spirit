---
import Base from '../layouts/Base.astro';
import { SITE_CONFIG, PLACEMENTS } from '../config.mjs';

const title = 'Featured Listing Pricing';
const description = `Get your retreat center featured at the top of your city page on ${SITE_CONFIG.name}. Pricing and details for featured placement.`;
const price = PLACEMENTS.pricing.featuredPerMonth;
const currency = PLACEMENTS.pricing.currency;
---

<Base title={title} description={description}>
  <div class="sr-container">
    <section class="sr-pricing-hero">
      <h1>Get Featured in Your City</h1>
      <p class="sr-pricing-hero__subtitle">
        Stand out at the top of your city page and reach more seekers looking for retreats in your area.
      </p>
    </section>

    <section class="sr-pricing-card">
      <div class="sr-pricing-card__header">
        <h2>Featured Placement</h2>
        <p class="sr-pricing-card__price">${currency} ${price}<span>/month</span></p>
      </div>

      <ul class="sr-pricing-card__features">
        <li>Pinned to the #1 position on your city page</li>
        <li>"Featured" badge displayed on your listing</li>
        <li>Priority placement above all organic results</li>
        <li>Direct link to your full profile page</li>
        <li>One featured slot per city — exclusive placement</li>
        <li>Cancel anytime, no long-term contract</li>
      </ul>

      <a href="/contact/" class="sr-pricing-card__cta">Get Started</a>
    </section>

    <section class="sr-pricing-faq">
      <h2>Frequently Asked Questions</h2>

      <div class="sr-faq-item">
        <h3>How does featured placement work?</h3>
        <p>
          Your listing is pinned to the top position on your city's page, above all other
          retreats. It retains its "Featured" badge so visitors know it's a promoted listing.
          Your star rating and review count are always shown unmodified.
        </p>
      </div>

      <div class="sr-faq-item">
        <h3>Can more than one retreat be featured per city?</h3>
        <p>
          No. We limit featured placement to one retreat per city page. This ensures your
          listing stands alone at the top without competing featured placements.
        </p>
      </div>

      <div class="sr-faq-item">
        <h3>Does featured placement affect my rating?</h3>
        <p>
          Never. Your displayed star rating and review count come directly from public business
          data and are never altered by paid placement. Featured listings are clearly labeled.
        </p>
      </div>

      <div class="sr-faq-item">
        <h3>How do I claim my listing?</h3>
        <p>
          Visit your retreat's profile page and click "Claim This Listing." You'll need to
          verify your association with the business. Once verified, you can manage contact
          details and apply for featured placement.
        </p>
      </div>

      <div class="sr-faq-item">
        <h3>What if my city page has an open featured slot?</h3>
        <p>
          If no retreat is currently featured in your city, the slot is open and available
          immediately on a first-come basis. Contact us to check availability.
        </p>
      </div>
    </section>

    <section class="sr-pricing-cta">
      <h2>Ready to Get Featured?</h2>
      <p>Contact us today to claim your city's featured slot.</p>
      <a href="/contact/" class="sr-button">Contact Us</a>
    </section>
  </div>

  <style>
    .sr-pricing-hero {
      text-align: center;
      margin-bottom: 3rem;
    }

    .sr-pricing-hero h1 {
      color: var(--accent-primary);
      font-size: 2.5rem;
    }

    .sr-pricing-hero__subtitle {
      font-size: 1.2rem;
      color: var(--text-secondary);
      max-width: 600px;
      margin: 1rem auto;
    }

    .sr-pricing-card {
      max-width: 500px;
      margin: 0 auto 4rem;
      padding: 2.5rem;
      background-color: var(--surface-secondary);
      border: 2px solid var(--accent-primary);
      border-radius: 0.75rem;
      text-align: center;
    }

    .sr-pricing-card__header h2 {
      font-size: 1.5rem;
      margin-bottom: 0.5rem;
    }

    .sr-pricing-card__price {
      font-size: 3rem;
      font-weight: 700;
      color: var(--accent-primary);
      font-family: var(--font-body);
      margin-bottom: 2rem;
    }

    .sr-pricing-card__price span {
      font-size: 1.2rem;
      font-weight: 500;
      color: var(--text-secondary);
    }

    .sr-pricing-card__features {
      list-style: none;
      text-align: left;
      margin-bottom: 2rem;
    }

    .sr-pricing-card__features li {
      padding: 0.5rem 0;
      padding-left: 1.75rem;
      position: relative;
      border-bottom: 1px solid var(--border);
    }

    .sr-pricing-card__features li::before {
      content: '\2713';
      position: absolute;
      left: 0;
      color: var(--accent-primary);
      font-weight: 700;
    }

    .sr-pricing-card__cta {
      display: inline-block;
      padding: 1rem 2.5rem;
      background-color: var(--accent-warm);
      color: white;
      border-radius: 0.375rem;
      font-weight: 600;
      font-size: 1.1rem;
      transition: background-color 0.2s;
    }

    .sr-pricing-card__cta:hover {
      background-color: #b86a35;
    }

    .sr-pricing-faq {
      max-width: 700px;
      margin: 0 auto 4rem;
    }

    .sr-pricing-faq h2 {
      text-align: center;
      margin-bottom: 2rem;
      color: var(--accent-primary);
    }

    .sr-faq-item {
      margin-bottom: 1.5rem;
      padding: 1.5rem;
      background-color: var(--surface-secondary);
      border-radius: 0.5rem;
      border: 1px solid var(--border);
    }

    .sr-faq-item h3 {
      font-size: 1.15rem;
      margin-bottom: 0.5rem;
      color: var(--accent-primary);
    }

    .sr-faq-item p {
      line-height: 1.6;
      color: var(--text-secondary);
    }

    .sr-pricing-cta {
      text-align: center;
      padding: 2.5rem;
      background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
      color: var(--surface-primary);
      border-radius: 0.5rem;
    }

    .sr-pricing-cta h2 {
      color: inherit;
      margin-bottom: 0.75rem;
    }

    .sr-pricing-cta p {
      margin-bottom: 1.5rem;
      color: rgba(255, 255, 255, 0.9);
    }

    .sr-button {
      display: inline-block;
      padding: 0.875rem 2rem;
      background-color: var(--accent-warm);
      color: white;
      border-radius: 0.25rem;
      font-weight: 600;
      transition: background-color 0.2s;
    }

    .sr-button:hover {
      background-color: #b86a35;
    }
  </style>
</Base>
